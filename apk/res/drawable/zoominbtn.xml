<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <bitmap android:gravity="center" android:src="@drawable/zoom_in" android:alpha="0.5" />
    </item>
    <item android:state_enabled="false">
        <bitmap android:gravity="center" android:src="@drawable/zoom_in" android:alpha="0.5" />
    </item>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/zoom_in" />
    </item>
</selector>
