<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background_fullscreen" />
    <LinearLayout android:paddingTop="0.0dp" style="@style/UiDialogFullScreenStyle">
        <FrameLayout android:background="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="right" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="horizontal" android:background="@drawable/label_blue_4" android:paddingLeft="@dimen/headerPaddingLeft" android:paddingTop="@dimen/bodyPaddingTop" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <com.metamoji.ui.common.UiTextView android:textSize="@dimen/notifyPreviewTitleTextSize" android:textColor="@color/notify_guidemovie_text" android:id="@id/dlg_title" style="@style/NotifyAddonStore_TextView" />
                </LinearLayout>
                <LinearLayout android:background="@drawable/label_blue_7" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_gravity="right" android:paddingTop="11.0dp" android:paddingRight="@dimen/bodyPaddingRight" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <com.metamoji.ui.common.UiButtonHeader android:id="@id/dlg_right_button" android:paddingTop="@dimen/headerButtonPaddingTop" android:layout_width="wrap_content" android:layout_height="@dimen/headerHeight" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <WebView android:id="@id/webPreview" android:layout_width="match_parent" android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
