<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <ScrollView style="@style/UiDialogScrollViewStyle">
            <LinearLayout android:orientation="horizontal" android:baselineAligned="false" style="@style/UiDialogBodyWithScrollStyle">
                <FrameLayout android:layout_gravity="center_vertical" android:background="@drawable/cabinet_thumbnail_dropshadow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/controlSpaceWide" android:layout_marginRight="@dimen/controlSpaceWide">
                    <ImageView android:layout_gravity="center" android:id="@id/image_libinfo_thumbnail" android:background="@android:color/white" android:layout_width="80.0dp" android:layout_height="80.0dp" android:scaleType="fitCenter" android:contentDescription="@null" />
                </FrameLayout>
                <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
                    <com.metamoji.ui.common.UiEditText android:id="@id/edit_libinfo_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/controlSpaceWide" android:hint="@string/Library_InfoDialog_PlaceHolder" android:inputType="text" android:privateImeOptions="com.metamoji.mazecapi?stroke_input=false" />
                    <LinearLayout android:orientation="horizontal" android:layout_marginBottom="@dimen/controlSpace" style="@style/UiDialogGroupUpStyle">
                        <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/Library_InfoDialog_Bookmark" style="@style/UiDialogLabelStyle" />
                        <com.metamoji.ui.common.UiSwitch android:id="@id/switch_libinfo_bookmark" style="@style/UiDialogSwitchStyle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
