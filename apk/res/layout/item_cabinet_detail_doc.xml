<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:id="@id/cabinetItemLinearLayout" android:background="@drawable/item_cabinet_detail_background" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:layout_width="@dimen/cabinetDetailThumbnailWidth" android:layout_height="@dimen/cabinetDetailThumbnailHeight" android:layout_marginLeft="@dimen/cabinetDetailThumbnailHPadding" android:layout_marginTop="@dimen/cabinetDetailThumbnailVPadding" android:layout_marginRight="@dimen/cabinetDetailThumbnailHPadding" android:layout_marginBottom="@dimen/cabinetDetailThumbnailVPadding">
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <ImageView android:id="@id/thumbnail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" />
            <ImageView android:id="@id/cabinetSync_Waiting" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/cabinet_sync_wait" android:layout_centerInParent="true" />
            <ImageView android:id="@id/cabinetSync_Syncing" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/cabinet_sync" android:layout_centerInParent="true" />
            <ImageView android:id="@id/cabinetSyncWait" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cabinetSyncWaitMarginTop" android:layout_marginRight="@dimen/cabinetSyncWaitMarginRight" android:src="@drawable/cabinet_note_icon_syncwait" android:layout_alignTop="@id/thumbnail" android:layout_alignRight="@id/thumbnail" />
            <ImageView android:id="@id/cabinetMultiSelectCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/cabinetMultiSelectMarginLeft" android:layout_marginTop="@dimen/cabinetMultiSelectMarginTop" android:src="@drawable/selector_cabinet_multiselect" android:layout_alignLeft="@id/thumbnail" android:layout_alignTop="@id/thumbnail" />
            <ImageView android:id="@id/cabinetnotetemplateicon" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/cabinetTemplateIconMarginRight" android:layout_marginBottom="@dimen/cabinetTemplateIconMarginBottom" android:src="@drawable/cabinet_icon_notetemplate" android:layout_alignRight="@id/thumbnail" android:layout_alignBottom="@id/thumbnail" />
            <ImageView android:id="@id/cabinetshareicon" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/cabinetShareIconMarginRight" android:layout_marginBottom="@dimen/cabinetShareIconMarginBottom" android:src="@drawable/cabinet_icon_collabo" android:layout_alignRight="@id/thumbnail" android:layout_alignBottom="@id/thumbnail" />
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:columnCount="2">
