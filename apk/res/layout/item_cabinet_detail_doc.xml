    <LinearLayout android:orientation="vertical" android:id="@id/normalTagViews" android:paddingTop="@dimen/cabinetDetailDateTextTopPadding" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <com.metamoji.ui.cabinet.DetailNormalTagView android:id="@id/tag1" style="@style/CabinetDetailNormalTag" />
        <com.metamoji.ui.cabinet.DetailNormalTagView android:id="@id/tag2" style="@style/CabinetDetailNormalTag" />
        <com.metamoji.ui.cabinet.DetailNormalTagView android:id="@id/tag3" style="@style/CabinetDetailNormalTag" />
        <com.metamoji.ui.cabinet.DetailNormalTagView android:id="@id/tag4" style="@style/CabinetDetailNormalTag" />
        <com.metamoji.ui.cabinet.DetailNormalTagView android:id="@id/tag5" android:paddingBottom="0.0dp" style="@style/CabinetDetailNormalTag" />
        <ImageView android:id="@id/detailNormalTagOverflow" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/cabinet_detail_tag_overflow" />
    </LinearLayout>
</LinearLayout>
