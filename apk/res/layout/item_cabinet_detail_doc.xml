            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:text="@string/Cabinet_CreateDate" style="@style/CabinetDetailText.Header" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/createDate" style="@style/CabinetDetailText.Value" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:text="@string/Cabinet_RenewDate" style="@style/CabinetDetailText.Header" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/updateDate" style="@style/CabinetDetailText.Value" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/createUserLabel" android:visibility="gone" android:text="@string/Cabinet_CreateUser" style="@style/CabinetDetailText.Header" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/createUser" android:visibility="gone" style="@style/CabinetDetailText.Value" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/updateUserLabel" android:visibility="gone" android:text="@string/Cabinet_RenewUser" style="@style/CabinetDetailText.Header" />
            <com.metamoji.ui.cabinet.OutlineCharacterOnActivatedTextView android:id="@id/updateUser" android:visibility="gone" style="@style/CabinetDetailText.Value" />
        </GridLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <GridLayout android:id="@id/smallTagViews" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:rowCount="2" android:columnCount="6">
                <ImageView android:id="@id/smallTag1" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag2" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag3" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag4" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag5" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag6" android:paddingRight="0.0dp" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag7" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag8" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag9" style="@style/CabinetDetailSmallTag" />
                <ImageView android:id="@id/smallTag10" style="@style/CabinetDetailSmallTag" />
