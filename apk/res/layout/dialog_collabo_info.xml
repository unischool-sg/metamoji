<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <LinearLayout android:layout_height="match_parent" style="@style/UiDialogBodyStyle">
            <com.metamoji.ui.common.UiRadioGroup android:orientation="horizontal" android:id="@id/radiogroup" android:layout_width="match_parent" android:layout_height="wrap_content" local:justify_width_withlargestchild="true">
                <com.metamoji.ui.common.UiRadioButton android:id="@id/button_user" android:layout_width="wrap_content" android:layout_height="wrap_content" local:maintitle="@string/TextUnitStyle_Layout" local:radiobutton_type="small_left" />
                <com.metamoji.ui.common.UiRadioButton android:id="@id/button_chat" android:layout_width="wrap_content" android:layout_height="wrap_content" local:maintitle="@string/ShareBar_Chat" local:radiobutton_type="small_right" />
            </com.metamoji.ui.common.UiRadioGroup>
            <FrameLayout android:id="@id/container" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_marginTop="@dimen/controlSpace" android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
