<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <ScrollView style="@style/UiDialogScrollViewStyle">
            <LinearLayout style="@style/UiDialogBodyWithScrollStyle">
                <TextView android:text="@string/ThumbnailSetting_Label1" style="@style/UiDialogGroupTitleStyle" />
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/controlSpaceWide" style="@style/UiDialogGroupDownStyle">
                    <com.metamoji.ui.common.UiRadioGroup android:orientation="horizontal" android:id="@id/dlg_doc_thumb_grp_used" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/controlSpace">
                        <com.metamoji.ui.common.UiRadioButton android:id="@id/dlg_doc_thumb_btn_none" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" local:maintitle="@string/ThumbnailSetting_NotSpecify" local:radiobutton_type="left" />
                        <com.metamoji.ui.common.UiRadioButton android:id="@id/dlg_doc_thumb_btn_use" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" local:maintitle="@string/ThumbnailSetting_Specify" local:radiobutton_type="right" />
                    </com.metamoji.ui.common.UiRadioGroup>
                    <TextView android:text="@string/ThumbnailSetting_Label2" style="@style/UiDialogGroupTitleStyle" />
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/controlSpaceWide" style="@style/UiDialogGroupDownStyle">
                        <LinearLayout android:gravity="right" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <ImageView android:id="@id/dlg_doc_thumb_preview" android:layout_width="32.0dp" android:layout_height="32.0dp" android:layout_marginRight="@dimen/controlSpace" />
                            <com.metamoji.ui.common.UiButton android:id="@id/dlg_doc_thumb_btn_import" android:layout_width="wrap_content" android:layout_height="wrap_content" local:button_type="sub" local:maintitle="@string/ThumbnailSetting_OpenPhoto" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
