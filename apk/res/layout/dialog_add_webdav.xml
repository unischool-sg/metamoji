<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <ScrollView style="@style/UiDialogScrollViewStyle">
            <LinearLayout style="@style/UiDialogBodyStyle">
                <TextView android:textSize="15.0dp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/WebDAV_Address" android:layout_centerHorizontal="true" android:layout_centerVertical="true" />
                <com.metamoji.ui.common.UiEditText android:id="@id/AddWebDav_Edit_Address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/WebDAV_Placeholder_Required" android:inputType="text" />
                <TextView android:textSize="15.0dp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/WebDAV_UserName" android:layout_centerHorizontal="true" android:layout_centerVertical="true" />
                <com.metamoji.ui.common.UiEditText android:id="@id/AddWebDav_Edit_UserName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/WebDAV_Placeholder_Optional" android:inputType="text" />
                <TextView android:textSize="15.0dp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/WebDAV_Password" android:layout_centerHorizontal="true" android:layout_centerVertical="true" />
                <com.metamoji.ui.common.UiEditText android:id="@id/AddWebDav_Edit_Password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/WebDAV_Placeholder_Optional" android:inputType="text" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
