            <com.metamoji.ui.common.UiButton android:id="@id/groupSelectBtn" android:layout_width="match_parent" android:layout_height="wrap_content" local:button_type="withsubmenu" />
            <LinearLayout android:orientation="horizontal" android:id="@id/displayOnlyStudents" android:layout_marginTop="@dimen/controlSpace" style="@style/UiDialogGroupUpStyle">
