                <com.metamoji.ui.common.UiEditText android:id="@id/searchText" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="@string/Cabinet_Tag_Search_Hint_Text_light" android:layout_weight="1.0" android:inputType="text" android:privateImeOptions="com.metamoji.mazecapi?stroke_input=false" />
            </LinearLayout>
            <RelativeLayout android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0">
