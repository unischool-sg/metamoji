<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <LinearLayout android:orientation="vertical" style="@style/UiDialogBodyStyle">
            <com.metamoji.ui.common.UiButton android:layout_gravity="center_horizontal" android:id="@id/bookmarklist_add" android:layout_width="match_parent" android:layout_height="wrap_content" local:button_type="withsubmenu" local:maintitle="@string/Bookmark_Add" />
            <com.metamoji.ui.common.UiButton android:enabled="false" android:layout_gravity="left" android:id="@id/bookmarklist_delete" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" local:button_type="sub" local:maintitle="@string/Cabinet_Button_Delete" />
            <Space android:layout_width="0.0dp" android:layout_height="@dimen/controlSpaceWide" />
            <ListView android:id="@id/bookmarklist_list" android:background="@drawable/collabo_bar_list_frame" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
