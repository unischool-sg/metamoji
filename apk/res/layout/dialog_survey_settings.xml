<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background" />
    <LinearLayout style="@style/UiDialogStyle">
        <include layout="@layout/control_dialog_header" />
        <ScrollView style="@style/UiDialogScrollViewStyle">
            <LinearLayout style="@style/UiDialogBodyWithScrollStyle">
                <com.metamoji.ui.common.UiTextView android:text="@string/MMJNT_LSTR_SURVEY_UNIT_QUESTION" style="@style/UiDialogGroupTitleStyle" />
                <com.metamoji.ui.common.UiEditText android:gravity="top" android:id="@id/question_edit" android:background="@drawable/edit_text_border" android:padding="4.0dp" android:layout_width="match_parent" android:layout_height="100.0dp" android:layout_marginBottom="@dimen/controlSpaceWide" android:inputType="textMultiLine" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="@dimen/controlSpace">
                    <com.metamoji.ui.common.UiTextView android:text="@string/MMJNT_LSTR_SURVEY_UNIT_CHOICES" android:layout_weight="1.0" style="@style/UiDialogGroupTitleStyle" />
                    <com.metamoji.ui.common.UiButton android:layout_gravity="right" android:id="@id/add_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10.0dp" android:minWidth="100.0dp" local:button_type="normal" local:maintitle="@string/School_GroupListDlg_Add_Group_Btn" local:maintitle_gravity="center_horizontal" />
                    <com.metamoji.ui.common.UiButton android:enabled="false" android:layout_gravity="right" android:id="@id/delete_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10.0dp" android:minWidth="100.0dp" local:button_type="normal" local:maintitle="@string/School_GroupListDlg_Delete_Group_Btn" local:maintitle_gravity="center_horizontal" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="@dimen/controlSpace">
                    <com.metamoji.forSchool.ui.ScListView android:id="@id/listView" android:background="@drawable/collabo_bar_list_frame" android:layout_width="match_parent" android:layout_height="200.0dp" android:divider="@null" android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_marginBottom="@dimen/controlSpaceWide" style="@style/UiDialogGroupUpStyle">
                    <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/MMJNT_LSTR_SURVEY_UNIT_ALLOW_MULTI_SELECTION" style="@style/UiDialogLabelStyle" />
                    <com.metamoji.ui.common.UiSwitch android:id="@id/switch_survey_type" style="@style/UiDialogSwitchStyle" />
                </LinearLayout>
                <com.metamoji.ui.common.UiTextView android:text="@string/MMJNT_LSTR_SURVEY_UNIT_OTHERS" style="@style/UiDialogGroupTitleStyle" />
                <LinearLayout android:orientation="horizontal" style="@style/UiDialogGroupUpStyleTop">
                    <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/MMJNT_LSTR_SURVEY_UNIT_ALLOW_TEACHER_ANSWER" style="@style/UiDialogLabelStyle" />
                    <com.metamoji.ui.common.UiSwitch android:id="@id/switch_allow_teacher_answer" style="@style/UiDialogSwitchStyle" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" style="@style/UiDialogGroupUpStyleMid">
                    <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/MMJNT_LSTR_SURVEY_UNIT_ALLOW_ANSWER" style="@style/UiDialogLabelStyle" />
                    <com.metamoji.ui.common.UiSwitch android:id="@id/switch_allow_answer" style="@style/UiDialogSwitchStyle" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" style="@style/UiDialogGroupUpStyleMid">
                    <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/MMJNT_LSTR_SURVEY_UNIT_PUBLISH_RESULT_TO_STUDENT" style="@style/UiDialogLabelStyle" />
                    <com.metamoji.ui.common.UiSwitch android:id="@id/switch_publish_result_to_student" style="@style/UiDialogSwitchStyle" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" style="@style/UiDialogGroupUpStyleBottom">
                    <com.metamoji.ui.common.UiTextView android:layout_marginRight="@dimen/controlSpace" android:text="@string/MMJNT_LSTR_SURVEY_UNIT_GRAPH_TYPE" style="@style/UiDialogLabelStyle" />
                    <com.metamoji.ui.common.UiRadioGroup android:layout_gravity="end" android:orientation="horizontal" android:id="@id/radiogroup_graph_type" android:layout_width="wrap_content" android:layout_height="wrap_content" local:justify_width_withlargestchild="true">
                        <com.metamoji.ui.common.UiRadioButton android:id="@id/button_pie_chart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/controlSpace" local:maintitle="@string/MMJNT_LSTR_SURVEY_UNIT_PIE_CHART" local:radiobutton_type="small_left" />
                        <com.metamoji.ui.common.UiRadioButton android:id="@id/button_bar_chart" android:layout_width="wrap_content" android:layout_height="wrap_content" local:maintitle="@string/MMJNT_LSTR_SURVEY_UNIT_BAR_GRAPH" local:radiobutton_type="small_right" />
                    </com.metamoji.ui.common.UiRadioGroup>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
