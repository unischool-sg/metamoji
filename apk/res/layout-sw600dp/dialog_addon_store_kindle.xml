                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/AddOnStoreLogoTopMargin" android:layout_marginBottom="@dimen/AddOnStoreLogoBottomMargin">
