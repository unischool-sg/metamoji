<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:local="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/control_dialog_background_fullscreen" />
    <LinearLayout android:paddingTop="0.0dp" style="@style/UiDialogFullScreenStyle">
